local rarities = {"All", "Common", "Rare", "Epic", "Legendary", "Mythic"}
local currentRarityY = 138

for _, rarityName in ipairs(rarities) do
    local RarityBtn = Instance.new("TextButton", LeftCol)
    RarityBtn.Position = UDim2.new(0, 0, 0, currentRarityY)
    RarityBtn.Size = UDim2.new(1, 0, 0, 24)
    RarityBtn.BackgroundColor3 = Color3.fromRGB(22, 24, 38)
    RarityBtn.Text = "  🎯 Rarity: " .. rarityName
    RarityBtn.TextColor3 = Color3.fromRGB(180, 190, 210)
    RarityBtn.TextSize = 9
    RarityBtn.Font = Enum.Font.GothamBold
    RarityBtn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", RarityBtn).CornerRadius = UDim.new(0, 4)
    local RStroke = Instance.new("UIStroke", RarityBtn)
    RStroke.Color = Color3.fromRGB(40, 45, 70)

    if rarityName:lower() == selectedEggRarity then
        RarityBtn.BackgroundColor3 = Color3.fromRGB(15, 45, 35)
        RarityBtn.TextColor3 = Color3.fromRGB(0, 255, 170)
        RStroke.Color = Color3.fromRGB(0, 255, 170)
    end

    RarityBtn.MouseButton1Click:Connect(function()
        selectedEggRarity = rarityName:lower()
        for _, child in pairs(LeftCol:GetChildren()) do
            if child:IsA("TextButton") and child.Text:find("Rarity:") then
                child.BackgroundColor3 = Color3.fromRGB(22, 24, 38)
                child.TextColor3 = Color3.fromRGB(180, 190, 210)
                local st = child:FindFirstChildOfClass("UIStroke")
                if st then st.Color = Color3.fromRGB(40, 45, 70) end
            end
        end
        RarityBtn.BackgroundColor3 = Color3.fromRGB(15, 45, 35)
        RarityBtn.TextColor3 = Color3.fromRGB(0, 255, 170)
        RStroke.Color = Color3.fromRGB(0, 255, 170)
    end)

    currentRarityY = currentRarityY + 28
end

