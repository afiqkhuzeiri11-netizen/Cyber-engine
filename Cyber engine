        selectedEggRarity = rarityName:lower()
        for _, child in pairs(LeftCol:GetChildren()) do
            if child:IsA("TextButton") and child.Text:find("Rarity:") then
                child.BackgroundColor3 = Color3.fromRGB(22, 24, 38)
                child.TextColor3 = Color3.fromRGB(180, 190, 210)
                local st = child:FindFirstChildOfClass("UIStroke")
                if st then st.Color = Color3.fromRGB(40, 45, 70) end
            end
        end
        RarityBtn.BackgroundColor3 = Color3.fromRGB(15, 45, 35)
        RarityBtn.TextColor3 = Color3.fromRGB(0, 255, 170)
        RStroke.Color = Color3.fromRGB(0, 255, 170)
    end)

    currentRarityY = currentRarityY + 28
end

