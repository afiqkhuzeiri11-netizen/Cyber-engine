-- [[ CYBER ENGINE V16 - ULTIMATE STABLE RAYFIELD UI ]] --

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Player = Players.LocalPlayer

-- Load Rayfield UI Library (Anti-Crash & 100% Work di Delta)
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "⚡ Cyber Engine V16 // Fish Riders",
   LoadingTitle = "Cyber Engine Loading...",
   LoadingSubtitle = "by Community",
   ConfigurationSaving = {
      Enabled = false,
   },
   KeySystem = false, 
})

-- Tab Utama
local FarmTab = Window:CreateTab("🌾 Auto Farm", 4483362458)
local PlayerTab = Window:CreateTab("🚀 Player & Speed", 4483362458)

-- Variabel Fitur
local isAutoPumpkin = false
local isAutoEgg = false
local isAutoCoin = false
local selectedRarity = "all"

local walkSpeedVal = 16
local swimSpeedVal = 16
local fishSpeedVal = 50

local isGodMode = false
local isInfJump = false
local isNoclip = false
local isESPActive = false
local isInfZoom = false

local farmedCache = {}

-- [ 1. FITUR AUTO FARM ] --
FarmTab:CreateToggle({
