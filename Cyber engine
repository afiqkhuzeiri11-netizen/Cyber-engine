      if v then swimSpeedVal = v end
   end,
})

PlayerTab:CreateInput({
   Name = "FishRide Speed (Default: 50)",
   PlaceholderText = "Masukkan angka...",
   NumbersOnly = true,
   Callback = function(Text)
      local v = tonumber(Text)
      if v then fishSpeedVal = v end
   end,
})

-- [ 3. BACKGROUND TASK: AUTO FARM & INTERACT ] --
task.spawn(function()
    while task.wait(0.5) do 
        pcall(function()
            if not isAutoPumpkin and not isAutoEgg and not isAutoCoin then return end
            local char = Player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            for _, obj in pairs(Workspace:GetDescendants()) do
                pcall(function()
                    if obj and (obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("ProximityPrompt")) then
                        local name = obj.Name:lower()
                        local fullName = name
                        local curr = obj
                        while curr and curr ~= Workspace do
                            fullName = fullName .. " " .. curr.Name:lower()
                            curr = curr.Parent
                        end
                        
                        local isTarget = false
                        if isAutoEgg and (name:find("egg") or name:find("telur") or name:find("nest")) then
                            if selectedRarity == "all" then
                                isTarget = true
                            else
                                if fullName:find(selectedRarity) then
                                    isTarget = true
                                end
                            end
                        elseif isAutoPumpkin and (name:find("pumpkin") or name:find("labu") or name:find("event")) then
                            isTarget = true
                        elseif isAutoCoin and (name:find("coin") or name:find("gem") or name:find("cash")) then
                            isTarget = true
                        end
                        
                        if isTarget then
                            local targetPart = nil
                            if obj:IsA("ProximityPrompt") then
                                targetPart = obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart")
                            elseif obj:IsA("Model") then
                                targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                            elseif obj:IsA("BasePart") then
                                targetPart = obj
                            end
                            
                            if targetPart and (not farmedCache[targetPart] or (tick() - farmedCache[targetPart] > 6)) then
                                farmedCache[targetPart] = tick()
                                hrp.CFrame = targetPart.CFrame
                                task.wait(0.1)
                                
                                local prompt = obj:IsA("ProximityPrompt") and obj or targetPart:FindFirstChildWhichIsA("ProximityPrompt", true)
                                if prompt and fireproximityprompt then
                                    fireproximityprompt(prompt)
                                end
                                
                                if firetouchinterest then
                                    firetouchinterest(hrp, targetPart, 0)
                                    task.wait(0.05)
                                    firetouchinterest(hrp, targetPart, 1)
                                end
                                task.wait(0.15)
                            end
                        end
                    end
                end)
            end
        end)
    end
end)

-- [ 4. HEARTBEAT LOOP (SPEED & GODMODE) ] --
RunService.Heartbeat:Connect(function()
    pcall(function()
        local char = Player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if hum then
            if hum:GetState() == Enum.HumanoidStateType.Swimming then
                hum.WalkSpeed = swimSpeedVal
            else
                hum.WalkSpeed = walkSpeedVal
            end
            if isGodMode then hum.Health = hum.MaxHealth end
        end

        for _, obj in pairs(Workspace:GetDescendants()) do
            pcall(function()
                if obj and (obj:IsA("VehicleSeat") or obj:IsA("Seat")) then
                    if hum and obj.Occupant == hum then
                        obj.AssemblyLinearVelocity = obj.CFrame.LookVector * fishSpeedVal
                    end
                end
            end)
        end

        if isNoclip then
            for _, part in pairs(char:GetDescendants()) do
                if part and part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)
end)

UserInputService.JumpRequest:Connect(function()
    pcall(function()
        if isInfJump and Player.Character then
            local hum = Player.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)
end)

