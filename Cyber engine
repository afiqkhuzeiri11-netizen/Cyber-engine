RunService.Heartbeat:Connect(function()
    pcall(function()
        local char = Player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if hum then
            if hum:GetState() == Enum.HumanoidStateType.Swimming then
                hum.WalkSpeed = swimSpeedVal
            else
                hum.WalkSpeed = walkSpeedVal
            end

            if isGodMode then hum.Health = hum.MaxHealth end
        end

        if isInfZoom then
            Player.CameraMaxZoomDistance = 999999
        else
            Player.CameraMaxZoomDistance = 400
        end

        for _, obj in pairs(Workspace:GetDescendants()) do
            pcall(function()
                if obj and (obj:IsA("VehicleSeat") or obj:IsA("Seat")) then
                    if hum and obj.Occupant == hum then
                        obj.AssemblyLinearVelocity = obj.CFrame.LookVector * fishSpeedVal
                    end
                end
            end)
        end

        if isNoclip then
            for _, part in pairs(char:GetDescendants()) do
                if part and part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)
end)

