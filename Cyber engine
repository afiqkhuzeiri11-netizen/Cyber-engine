local function addSection(parent, titleText, yPos)
    local lbl = Instance.new("TextLabel", parent)
    lbl.Position = UDim2.new(0, 0, 0, yPos)
    lbl.Size = UDim2.new(1, 0, 0, 16)
    lbl.BackgroundTransparency = 1
    lbl.Text = titleText
    lbl.TextColor3 = Color3.fromRGB(255, 140, 0)
    lbl.TextSize = 10
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    return lbl
end

local function addToggle(parent, text, yPos, callback)
    local Btn = Instance.new("TextButton", parent)
    Btn.Position = UDim2.new(0, 0, 0, yPos)
    Btn.Size = UDim2.new(1, 0, 0, 28)
    Btn.BackgroundColor3 = Color3.fromRGB(22, 24, 38)
    Btn.Text = "  " .. text
    Btn.TextColor3 = Color3.fromRGB(180, 190, 210)
    Btn.TextSize = 10
    Btn.Font = Enum.Font.GothamBold
    Btn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 5)
    local Stroke = Instance.new("UIStroke", Btn)
    Stroke.Color = Color3.fromRGB(40, 45, 70)

    local Badge = Instance.new("TextLabel", Btn)
    Badge.Position = UDim2.new(1, -45, 0, 4)
    Badge.Size = UDim2.new(0, 38, 0, 20)
    Badge.BackgroundColor3 = Color3.fromRGB(40, 20, 30)
    Badge.Text = "OFF"
    Badge.TextColor3 = Color3.fromRGB(255, 70, 90)
    Badge.TextSize = 9
    Badge.Font = Enum.Font.GothamBold
    Instance.new("UICorner", Badge).CornerRadius = UDim.new(0, 4)

    local active = false
    Btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            Badge.Text = "ON"
            Badge.TextColor3 = Color3.fromRGB(0, 255, 170)
            Badge.BackgroundColor3 = Color3.fromRGB(15, 45, 35)
            Stroke.Color = Color3.fromRGB(0, 255, 170)
        else
            Badge.Text = "OFF"
            Badge.TextColor3 = Color3.fromRGB(255, 70, 90)
            Badge.BackgroundColor3 = Color3.fromRGB(40, 20, 30)
            Stroke.Color = Color3.fromRGB(40, 45, 70)
        end
        callback(active)
    end)
end

